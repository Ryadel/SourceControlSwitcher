  <Target Name="EnsureStrongNameKey" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\..\Key.snk')">
    <Exec Command="&quot;$(TargetFrameworkSDKToolsDirectory)sn.exe&quot; -k &quot;$(MSBuildProjectDirectory)\..\Key.snk&quot;" />
